bedrock/web/app/mu-plugins/*/
bedrock/web/app/themes/twentytwentyfive/
bedrock/web/app/upgrade
bedrock/web/app/uploads/*
!bedrock/web/app/uploads/.gitkeep
bedrock/web/app/cache/*

# Ignore wordpress sqlite
bedrock/sqlite/wp.sqlite

# WordPress
bedrock/web/wp
bedrock/web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
bedrock/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

.DS_Store
